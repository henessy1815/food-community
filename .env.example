# Supabase — 서버 전용 (NEXT_PUBLIC_ 접두사 금지)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Storage 공개 주소 — <SUPABASE_URL>/storage/v1/object/public
SUPABASE_STORAGE_URL=

# 네이버 지역 검색 (NCP · NAVER API HUB → 검색 > 지역) — 서버 전용, /api/places/search가 호출
# NCP 콘솔에서 NAVER API HUB 검색 상품을 구독한 Application의 Client ID · Client Secret
# 지도와 같은 Application이면 비워두세요 (NCP_MAP_KEY_ID · NCP_MAP_KEY를 사용)
NCP_SEARCH_KEY_ID=
NCP_SEARCH_KEY=

# 네이버 지도 (NCP · Maps Application) — Dynamic Map(JS SDK) + Reverse Geocoding
# - NCP_MAP_KEY: 서버 전용 시크릿, /api/places/reverse가 Reverse Geocoding 호출에 사용
# - NCP_MAP_KEY_ID: /api/places/map/sdk가 JS SDK 주소에 붙여 내려준다 (SDK 특성상 브라우저에 노출되는 공개 키)
#   → NCP 콘솔 Application에서 Dynamic Map · Reverse Geocoding을 켜고,
#     Web 서비스 URL에 http://localhost:3000 · http://localhost:6006(Storybook) · 배포 도메인을 등록해야 인증된다
NCP_MAP_KEY_ID=
NCP_MAP_KEY=
