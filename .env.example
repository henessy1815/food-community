# .env.local로 복사해 값을 채운다 — 모든 키는 서버 전용 (NEXT_PUBLIC_ 접두사 금지)

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Storage 공개 주소 — DB의 이미지 경로(place_image.image_path · product.image_path_*)와 조합해 이미지 URL을 만든다
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public
# secret 키 (service role) — 결제 원장 기록(record_payment_*)에만 사용. 절대 클라이언트에 노출 금지
# 대시보드 › Project Settings › API Keys › Secret keys
SUPABASE_SECRET_KEY=sb_secret_...

# 네이버 지도 (NCP · Maps Application)
NCP_MAP_KEY_ID=
NCP_MAP_KEY=
# 네이버 지역 검색 (NCP · NAVER API HUB) — 지도와 같은 Application이면 비워두세요
NCP_SEARCH_KEY_ID=
NCP_SEARCH_KEY=

# 포트원 V2 결제 — 규칙 SSOT: .claude/rules/payment.md
# 상점 ID · 채널 키: 포트원 콘솔 › 결제 연동 › 연동 정보 (결제창 호출용, /api/payments/prepare가 내려준다)
PORTONE_STORE_ID=store-284066dc-41df-4df0-a89a-054510f96550
PORTONE_CHANNEL_KEY=channel-key-50388b0a-b5cb-496d-8f56-9d3d675632db
# V2 API Secret: 포트원 콘솔 › 결제 연동 › 연동 정보 › API Keys — 결제 조회 · 취소 (서버 전용 비밀값)
PORTONE_API_SECRET=
# 웹훅 시크릿 (웹훅 연동 시) — 포트원 콘솔 › 결제 연동 › 웹훅
# PORTONE_WEBHOOK_SECRET=
